{
  "$schema": "../../chetah.schema.json",
  "tables": {
    "departments": {
      "$id": 1,
      "model": "Department",
      "columns": {
        "id": { "$id": 1, "type": "integer", "nullable": false, "primaryKey": true, "identity": true },
        "code": { "$id": 2, "type": "varchar(16)", "nullable": false, "unique": true },
        "name": { "$id": 3, "type": "varchar(120)", "nullable": false }
      }
    },

    "instructors": {
      "$id": 2,
      "model": "Professor",
      "unique": [
        { "columns": ["department_id", "first_name", "last_name"] }
      ],
      "indexes": [
        { "name": "professors_department_idx", "keys": [{ "column": "department_id" }] }
      ],
      "foreignKeys": [
        {
          "name": "professors_department_fkey",
          "columns": ["department_id"],
          "references": { "table": "departments", "columns": ["id"] },
          "onDelete": "CASCADE",
          "onUpdate": "CASCADE"
        }
      ],
      "columns": {
        "id": { "$id": 1, "type": "integer", "nullable": false, "primaryKey": true, "identity": true },
        "department_id": { "$id": 2, "type": "integer", "nullable": false },
        "first_name": { "$id": 3, "type": "varchar(80)", "nullable": false },
        "last_name": { "$id": 4, "type": "varchar(80)", "nullable": false },
        "email": { "$id": 5, "type": "varchar(320)", "nullable": false, "unique": true },
        "active": { "$id": 6, "type": "boolean", "nullable": false, "default": true }
      }
    },

    "students": {
      "$id": 3,
      "model": "Student",
      "indexes": [
        { "name": "students_department_year_idx", "keys": [{ "column": "department_id" }, { "column": "index_number" }] },
        { "name": "students_phone_idx", "keys": [{ "column": "phone" }] }
      ],
      "foreignKeys": [
        {
          "name": "students_department_fkey",
          "columns": ["department_id"],
          "references": { "table": "departments", "columns": ["id"] },
          "onDelete": "RESTRICT",
          "onUpdate": "CASCADE"
        },
        {
          "name": "students_invalid_reference_fkey",
          "columns": ["invalid_reference"],
          "references": { "table": "departments", "columns": ["id"] }
        }
      ],
      "columns": {
        "id": { "$id": 1, "type": "bigint", "nullable": false, "primaryKey": true, "identity": true },
        "department_id": { "$id": 2, "type": "integer", "nullable": false },
        "index_number": { "$id": 3, "type": "varchar(24)", "nullable": false, "unique": true },
        "first_name": { "$id": 4, "type": "varchar(80)", "nullable": false },
        "last_name": { "$id": 5, "type": "varchar(80)", "nullable": false },
        "enrollment_year": { "$id": 6, "type": "integer", "nullable": true },
        "phone": { "$id": 8, "type": "varchar(30)", "nullable": true },
        "test_flag": { "$id": 9, "type": "boolean", "nullable": true },
        "invalid_reference": { "$id": 10, "type": "integer", "nullable": true }
      }
    },

    "courses": {
      "$id": 4,
      "model": "Course",
      "unique": [
        { "columns": ["department_id", "code"] }
      ],
      "foreignKeys": [
        {
          "name": "courses_department_fkey",
          "columns": ["department_id"],
          "references": { "table": "departments", "columns": ["id"] },
          "onDelete": "RESTRICT",
          "onUpdate": "CASCADE"
        }
      ],
      "columns": {
        "id": { "$id": 1, "type": "integer", "nullable": false, "primaryKey": true, "identity": true },
        "department_id": { "$id": 2, "type": "integer", "nullable": false },
        "code": { "$id": 3, "type": "varchar(20)", "nullable": false },
        "course_name": { "$id": 4, "type": "varchar(160)", "nullable": false },
        "credits": { "$id": 5, "type": "integer", "nullable": false, "default": 5 }
      }
    },

    "semesters": {
      "$id": 5,
      "model": "Semester",
      "unique": [
        { "columns": ["academic_year", "term"] }
      ],
      "columns": {
        "id": { "$id": 1, "type": "integer", "nullable": false, "primaryKey": true, "identity": true },
        "academic_year": { "$id": 2, "type": "varchar(9)", "nullable": false },
        "term": { "$id": 3, "type": "varchar(12)", "nullable": false },
        "starts_at": { "$id": 4, "type": "timestamp", "nullable": false },
        "ends_at": { "$id": 5, "type": "timestamp", "nullable": false }
      }
    },

    "course_offerings": {
      "$id": 6,
      "model": "CourseOffering",
      "unique": [
        { "columns": ["course_id", "semester_id", "group_code"] }
      ],
      "indexes": [
        { "name": "course_offerings_professor_idx", "keys": [{ "column": "professor_id" }] }
      ],
      "foreignKeys": [
        {
          "name": "offerings_course_fkey",
          "columns": ["course_id"],
          "references": { "table": "courses", "columns": ["id"] },
          "onDelete": "RESTRICT"
        },
        {
          "name": "offerings_semester_fkey",
          "columns": ["semester_id"],
          "references": { "table": "semesters", "columns": ["id"] },
          "onDelete": "RESTRICT"
        },
        {
          "name": "offerings_professor_fkey",
          "columns": ["professor_id"],
          "references": { "table": "instructors", "columns": ["id"] },
          "onDelete": "RESTRICT",
          "onUpdate": "CASCADE"
        }
      ],
      "columns": {
        "id": { "$id": 1, "type": "bigint", "nullable": false, "primaryKey": true, "identity": true },
        "course_id": { "$id": 2, "type": "integer", "nullable": false },
        "semester_id": { "$id": 3, "type": "integer", "nullable": false },
        "professor_id": { "$id": 4, "type": "integer", "nullable": true },
        "group_code": { "$id": 5, "type": "varchar(12)", "nullable": false, "default": "A" }
      }
    },

    "enrollments": {
      "$id": 7,
      "model": "Enrollment",
      "primaryKey": { "columns": ["student_id", "offering_id"] },
      "indexes": [
        { "name": "enrollments_offering_idx", "keys": [{ "column": "offering_id" }] }
      ],
      "foreignKeys": [
        {
          "name": "enrollments_student_fkey",
          "columns": ["student_id"],
          "references": { "table": "students", "columns": ["id"] },
          "onDelete": "CASCADE",
          "onUpdate": "CASCADE"
        },
        {
          "name": "enrollments_offering_fkey",
          "columns": ["offering_id"],
          "references": { "table": "course_offerings", "columns": ["id"] },
          "onDelete": "CASCADE",
          "onUpdate": "CASCADE"
        }
      ],
      "columns": {
        "student_id": { "$id": 1, "type": "bigint", "nullable": false },
        "offering_id": { "$id": 2, "type": "bigint", "nullable": false },
        "enrolled_at": { "$id": 3, "type": "timestamp", "nullable": false, "default": { "sql": "now()" } },
        "status": { "$id": 4, "type": "varchar(20)", "nullable": false, "default": "enrolled" }
      }
    },

    "grades": {
      "$id": 8,
      "model": "Grade",
      "primaryKey": { "columns": ["student_id", "offering_id"] },
      "checks": [
        { "name": "chk_grades_valid_grade", "expression": "grade BETWEEN 5 AND 10" }
      ],
      "indexes": [
        { "name": "grades_offering_idx", "keys": [{ "column": "offering_id" }] }
      ],
      "foreignKeys": [
        {
          "name": "grades_enrollment_fkey",
          "columns": ["student_id", "offering_id"],
          "references": { "table": "enrollments", "columns": ["student_id", "offering_id"] },
          "onDelete": "CASCADE",
          "onUpdate": "CASCADE"
        }
      ],
      "columns": {
        "student_id": { "$id": 1, "type": "bigint", "nullable": false },
        "offering_id": { "$id": 2, "type": "bigint", "nullable": false },
        "grade": { "$id": 3, "type": "integer", "nullable": false },
        "graded_at": { "$id": 4, "type": "timestamp", "nullable": false, "default": { "sql": "now()" } },
        "comment": { "$id": 5, "type": "text" }
      }
    }
  }
}
