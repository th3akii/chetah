      "operations": [
        {
          "kind": "create_table",
          "table": "departments",
          "column": null,
          "destructive": false,
          "statement": "CREATE TABLE \"departments\" (\n    \"id\" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,\n    \"code\" varchar(16) NOT NULL,\n    \"name\" varchar(120) NOT NULL,\n    CONSTRAINT \"departments_pkey\" PRIMARY KEY (\"id\"),\n    CONSTRAINT \"departments_code_key\" UNIQUE (\"code\")\n)"
        },
        {
          "kind": "create_table",
          "table": "professors",
          "column": null,
          "destructive": false,
          "statement": "CREATE TABLE \"professors\" (\n    \"id\" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,\n    \"department_id\" integer NOT NULL,\n    \"first_name\" varchar(80) NOT NULL,\n    \"last_name\" varchar(80) NOT NULL,\n    \"email\" varchar(200) NOT NULL,\n    \"active\" boolean NOT NULL DEFAULT true,\n    CONSTRAINT \"professors_pkey\" PRIMARY KEY (\"id\"),\n    CONSTRAINT \"professors_email_key\" UNIQUE (\"email\")\n)"
        },
        {
          "kind": "create_table",
          "table": "students",
          "column": null,
          "destructive": false,
          "statement": "CREATE TABLE \"students\" (\n    \"id\" bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,\n    \"department_id\" integer NOT NULL,\n    \"student_number\" varchar(24) NOT NULL,\n    \"first_name\" varchar(80) NOT NULL,\n    \"last_name\" varchar(80) NOT NULL,\n    \"enrollment_year\" integer NOT NULL,\n    \"created_at\" timestamp(3) NOT NULL DEFAULT now(),\n    CONSTRAINT \"students_pkey\" PRIMARY KEY (\"id\"),\n    CONSTRAINT \"students_student_number_key\" UNIQUE (\"student_number\")\n)"
        },
        {
          "kind": "create_table",
          "table": "courses",
          "column": null,
          "destructive": false,
          "statement": "CREATE TABLE \"courses\" (\n    \"id\" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,\n    \"department_id\" integer NOT NULL,\n    \"code\" varchar(20) NOT NULL,\n    \"title\" varchar(160) NOT NULL,\n    \"credits\" integer NOT NULL DEFAULT 6,\n    CONSTRAINT \"courses_pkey\" PRIMARY KEY (\"id\"),\n    CONSTRAINT \"courses_department_id_code_key\" UNIQUE (\"department_id\", \"code\")\n)"
        },
        {
          "kind": "create_table",
          "table": "semesters",
          "column": null,
          "destructive": false,
          "statement": "CREATE TABLE \"semesters\" (\n    \"id\" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,\n    \"academic_year\" varchar(9) NOT NULL,\n    \"term\" varchar(12) NOT NULL,\n    \"starts_at\" timestamp NOT NULL,\n    \"ends_at\" timestamp NOT NULL,\n    CONSTRAINT \"semesters_pkey\" PRIMARY KEY (\"id\"),\n    CONSTRAINT \"semesters_academic_year_term_key\" UNIQUE (\"academic_year\", \"term\")\n)"
        },
        {
          "kind": "create_table",
          "table": "course_offerings",
          "column": null,
          "destructive": false,
          "statement": "CREATE TABLE \"course_offerings\" (\n    \"id\" bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,\n    \"course_id\" integer NOT NULL,\n    \"semester_id\" integer NOT NULL,\n    \"professor_id\" integer,\n    \"group_code\" varchar(12) NOT NULL DEFAULT 'A',\n    \"capacity\" integer NOT NULL DEFAULT 30,\n    CONSTRAINT \"course_offerings_pkey\" PRIMARY KEY (\"id\"),\n    CONSTRAINT \"course_offerings_course_id_semester_id_group_code_key\" UNIQUE (\"course_id\", \"semester_id\", \"group_code\")\n)"
        },
        {
          "kind": "create_table",
          "table": "enrollments",
          "column": null,
          "destructive": false,
          "statement": "CREATE TABLE \"enrollments\" (\n    \"student_id\" bigint NOT NULL,\n    \"offering_id\" bigint NOT NULL,\n    \"enrolled_at\" timestamp NOT NULL DEFAULT now(),\n    \"status\" varchar(20) NOT NULL DEFAULT 'enrolled',\n    CONSTRAINT \"enrollments_pkey\" PRIMARY KEY (\"student_id\", \"offering_id\")\n)"
        },
        {
          "kind": "create_table",
          "table": "grades",
          "column": null,
          "destructive": false,
          "statement": "CREATE TABLE \"grades\" (\n    \"id\" bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,\n    \"student_id\" bigint NOT NULL,\n    \"offering_id\" bigint NOT NULL,\n    \"attempt_number\" integer NOT NULL DEFAULT 1,\n    \"grade_value\" integer NOT NULL,\n    \"graded_at\" timestamp NOT NULL DEFAULT now(),\n    \"notes\" text,\n    CONSTRAINT \"grades_pkey\" PRIMARY KEY (\"id\"),\n    CONSTRAINT \"grades_student_id_offering_id_attempt_number_key\" UNIQUE (\"student_id\", \"offering_id\", \"attempt_number\")\n)"
