{
  "$schema": "../../chetah.schema.json",
  // Comments are allowed: the parser reads JSONC.
  "enums": {
    "user_status": ["active", "inactive", "banned", "line\nbreak", "carriage\rreturn", "tab\there", "control\u0001"]
  },
  "tables": {
    "test_widgets": {
      "columns": {
        "id": { "type": "integer", "nullable": false },
        "label": { "type": "text" },
        "quantity": { "type": "bigint", "nullable": false },
        "active": { "type": "boolean", "nullable": false },
        "token": { "type": "uuid" },
        "created": { "type": "timestamp", "nullable": false }
      }
    },
    "users": {
      "model": "Stage2User",
      "columns": {
        "id": { "type": "integer", "nullable": false },
        "name": { "type": "text", "nullable": false },
        "age": { "type": "integer" }
      }
    },
    "orders": {
      "model": "Stage2Order",
      "columns": {
        "id": { "type": "integer", "nullable": false },
        "user_id": { "type": "integer", "nullable": false },
        "amount": { "type": "integer", "nullable": false },
        "note": { "type": "text" }
      }
    },
    "students": {
      "model": "Student",
      "columns": {
        "id": { "type": "integer", "nullable": false, "identity": true, "primaryKey": true },
        "first_name": { "type": "text", "nullable": false, "unique": true },
        "age": { "type": "integer" },
        "nickname": { "type": "text", "default": "anon" },
        "status": { "type": "text", "nullable": false, "default": "active" },
        "display": {
          "type": "text",
          "nullable": false,
          "generated": { "expression": "first_name || '!'" }
        }
      }
    },
    "notes": {
      "model": "Note",
      "columns": {
        "id": { "type": "integer", "nullable": false, "identity": true },
        "body": { "type": "text" }
      }
    },
    "always_notes": {
      "model": "AlwaysNote",
      "columns": {
        "id": {
          "type": "integer",
          "nullable": false,
          "identity": { "generation": "ALWAYS" }
        },
        "body": { "type": "text" }
      }
    }
  }
}
